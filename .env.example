# =========================================================
#  Настройки нейросети для генератора постов
#  Скопируй этот файл в .env и впиши свои значения.
#  ВАЖНО: файл .env не попадает в git (см. .gitignore).
# =========================================================

# Ключ API OpenAI-совместимого сервиса (обязателен для режима «Нейросеть»).
OPENAI_API_KEY=

# Базовый адрес API.
#   OpenAI:       https://api.openai.com/v1          (по умолчанию)
#   DeepSeek:     https://api.deepseek.com/v1
#   OpenRouter:   https://openrouter.ai/api/v1
#   Ollama:       http://localhost:11434/v1          (локальная нейросеть)
OPENAI_BASE_URL=https://api.openai.com/v1

# Название модели.
#   OpenAI:       gpt-4o-mini                        (по умолчанию)
#   DeepSeek:     deepseek-chat
#   Ollama:       имя скачанной модели, например llama3
AI_MODEL=gpt-4o-mini